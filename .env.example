# Device Configuration
DEVICE_ID=          # Optional: Leave empty to auto-generate UUID
DEVICE_NAME=my-device
CLIENT_KEY=         # Optional: Leave empty to auto-generate client key

# Server Configuration
PORT=8080

# App lock password (default 12345678 if unset)
PASSWORD=12345678

# Keep Pegasus running in the system tray when its window is closed
RUN_IN_BACKGROUND=true
